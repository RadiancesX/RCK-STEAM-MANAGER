{
  "name": "rck-steam-manager",
  "productName": "RCK Steam Manager",
  "version": "0.4.0",
  "description": "Steam kart/saat idle, başarım (açma/sıfırlama) ve liste yöneticisi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npx --yes electron-builder --win portable"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "steam-session": "^1.9.4",
    "steam-user": "^5.3.0",
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "electron": "^44.4.5"
  },
  "build": {
    "appId": "com.rck.steammanager",
    "productName": "RCK Steam Manager",
    "asarUnpack": [
      "ach-worker.js",
      "node_modules/steamworks.js/**"
    ],
    "extraFiles": [
      {
        "from": "node_modules/steamworks.js/dist/win64/steam_api64.dll",
        "to": "."
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    }
  }
}
